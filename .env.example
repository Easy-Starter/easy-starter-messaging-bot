APP_NAME=Easy Starter Messenger Bot
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1
APP_DOCS_ENABLED=true

PUBLIC_BASE_URL=https://example.com

DATABASE_URL=postgresql+psycopg://messenger:messenger@postgres:5432/messenger

REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
REDIS_SCHEDULE_URL=redis://redis:6379/3

INTERNAL_API_KEY=replace-me

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

BALE_ENABLED=false
BALE_BOT_TOKEN=
BALE_API_BASE_URL=https://tapi.bale.ai
BALE_WEBHOOK_SECRET=

WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=

OTEL_ENABLED=false
OTEL_SERVICE_NAME=easy-starter-messenger-bot
OTEL_EXPORTER_OTLP_ENDPOINT=

SENTRY_DSN=